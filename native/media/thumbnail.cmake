find_package(Qt6 6.11.2 EXACT REQUIRED COMPONENTS Gui)
add_library(valmax_media_thumbnail STATIC thumbnail.cpp thumbnail.h)
target_include_directories(valmax_media_thumbnail PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
target_link_libraries(valmax_media_thumbnail PUBLIC valmax_media_protocol Qt6::Gui)
target_compile_definitions(valmax_media_thumbnail PRIVATE QT_NO_CAST_FROM_ASCII QT_NO_CAST_TO_ASCII)
if(MSVC)
  target_compile_options(valmax_media_thumbnail PRIVATE /W4 /WX /permissive- /utf-8)
endif()
if(VALMAX_MEDIA_TESTS)
  add_executable(valmax_media_thumbnail_test ../tests/media/thumbnail_test.cpp)
  target_link_libraries(valmax_media_thumbnail_test PRIVATE valmax_media_thumbnail)
  if(MSVC)
    target_compile_options(valmax_media_thumbnail_test PRIVATE /W4 /WX /permissive- /utf-8)
  endif()
  add_test(NAME media_thumbnail COMMAND valmax_media_thumbnail_test)
endif()
