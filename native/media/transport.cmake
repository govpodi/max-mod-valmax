find_package(Qt6 6.11.2 EXACT REQUIRED COMPONENTS Network)
add_library(valmax_media_transport STATIC transport.cpp transport.h)
target_include_directories(valmax_media_transport PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
target_link_libraries(valmax_media_transport PUBLIC valmax_media_scheduler Qt6::Network)
target_compile_definitions(valmax_media_transport PRIVATE QT_NO_CAST_FROM_ASCII QT_NO_CAST_TO_ASCII)
if(MSVC)
  target_compile_options(valmax_media_transport PRIVATE /W4 /WX /permissive- /utf-8)
endif()
if(VALMAX_MEDIA_TESTS)
  add_executable(valmax_media_transport_test ../tests/media/transport_test.cpp)
  target_link_libraries(valmax_media_transport_test PRIVATE valmax_media_transport)
  if(MSVC)
    target_compile_options(valmax_media_transport_test PRIVATE /W4 /WX /permissive- /utf-8)
  endif()
  add_test(NAME media_transport COMMAND valmax_media_transport_test)
endif()
